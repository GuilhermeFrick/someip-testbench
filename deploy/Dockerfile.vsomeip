# Imagem base da bancada: vsomeip (COVESA) compilado, mais ferramentas de captura.
#
# Todos os nos ECU herdam desta imagem. Ela e deliberadamente a UNICA que compila
# o vsomeip: os nos so acrescentam o proprio binario, para que o tempo de build
# da bancada nao cresca a cada no.
#
# BASE é parâmetro por causa das versões antigas do vsomeip: a série 3.1 não
# compila com o Boost do Ubuntu 24.04. A bancada padrão é 24.04 + 3.5.6 (ver
# VSOMEIP_REF abaixo); as outras combinações existem para comparar versões, como
# em platform/dup-offer e platform/scenario-live.
ARG BASE=ubuntu:24.04
FROM ${BASE}

ARG DEBIAN_FRONTEND=noninteractive
# Tag FIXA, nao master: a bancada precisa ser reproduzivel.
#
# 3.5.6, e nao a 3.6.4 usada ate 2026-11-02, porque e a versao que REPRODUZ o
# dataset do Kim: 99,1% de TCP no barramento benigno (a 3.6.4 dava 98%) e, no
# DoS, 58,9%/41,1% de UDP/TCP contra 59,5%/40,5% do dataset. A 3.6.4 recusa a
# assinatura que o atacante do dataset aceita (platform/scenario-live). E e a
# mais recente que existia quando o dataset foi capturado (2025-08-08).
# Trocar de versao exige repetir platform/sd-smoke e platform/bus-kim.
ARG VSOMEIP_REF=3.5.6

# Dois grupos nao sao do vsomeip, e estao aqui para que UMA invocacao do
# tests/run_all.sh dentro desta imagem rode a suite INTEIRA. Antes nao havia
# maquina capaz disso: o test_packet_source ficava PULADO aqui e o test_libecu
# ficava PULADO na imagem da paridade.
#
#   libpcap-dev     do ids_sensor: e com ele que o PcapSource captura no
#                   barramento e replica PCAP. O no de sensor roda nesta imagem.
#   python3 + yaml  do tools/gen_config.py e do tests/check_comm_matrix.py, que
#                   leem a matriz de comunicacao. Pelo apt e nao pelo pip, que no
#                   Ubuntu 24.04 exigiria --break-system-packages.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git ca-certificates \
        libboost-system-dev libboost-thread-dev libboost-filesystem-dev \
        libboost-log-dev libboost-program-options-dev \
        libpcap-dev \
        python3 python3-yaml \
        tcpdump iproute2 iputils-ping \
    && rm -rf /var/lib/apt/lists/*

# vsomeip: pilha SOME/IP de referencia. E a mesma usada para gerar o dataset do
# baseline, o que da continuidade metodologica ao trabalho.
RUN git clone --depth 1 --branch ${VSOMEIP_REF} https://github.com/COVESA/vsomeip.git /src/vsomeip

WORKDIR /src/vsomeip/build
RUN cmake -DCMAKE_BUILD_TYPE=Release \
          -DENABLE_SIGNAL_HANDLING=1 \
          -DCMAKE_INSTALL_PREFIX=/usr/local \
          .. \
    && make -j"$(nproc)" \
    && make install \
    && ldconfig

# Os exemplos do proprio vsomeip servem de teste de fumaca do Service Discovery,
# antes de existir qualquer no nosso.
RUN make -j"$(nproc)" notify-sample subscribe-sample || true

ENV LD_LIBRARY_PATH=/usr/local/lib
WORKDIR /work
CMD ["/bin/bash"]
