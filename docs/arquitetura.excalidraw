   "type": "text",
   "id": "t003",
   "x": 40,
   "y": 120,
   "width": 567,
   "height": 30,
   "strokeColor": "#0c8599",
   "backgroundColor": "transparent",
   "text": "1 · A matriz de comunicacao e a fonte unica",
   "originalText": "1 · A matriz de comunicacao e a fonte unica",
   "fontSize": 24,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "isDeleted": false,
   "fillStyle": "solid",
