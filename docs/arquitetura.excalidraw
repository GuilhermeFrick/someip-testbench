   "type": "text",
   "id": "t004",
   "x": 40,
   "y": 156,
   "width": 746,
   "height": 17,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "text": "Como no CANoe, tudo nasce de um unico arquivo. Um gerador produz o resto de forma deterministica.",
   "originalText": "Como no CANoe, tudo nasce de um unico arquivo. Um gerador produz o resto de forma deterministica.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
